# General settings
APP_NAME=zhkh-dispatcher-api
APP_ENV=dev
DEBUG=True
APP_BASE_URL=http://localhost:8000

# Security
JWT_SECRET=CHANGE_ME_SUPER_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CHAT_WEBHOOK_SECRET=
TELEGRAM_BOT_INTERNAL_SECRET=
TELEGRAM_BOT_SERVICE_URL=
TELEGRAM_BOT_NOTIFY_TIMEOUT_SECONDS=10
TELEGRAM_LINK_CODE_MINUTES=60

# Database
POSTGRES_DB=zhkh
POSTGRES_USER=zhkh_user
POSTGRES_PASSWORD=change_me
POSTGRES_URL=postgresql+asyncpg://zhkh_user:change_me@db:5432/zhkh

# Email
MAIL_USERNAME=example@gmail.com
MAIL_PASSWORD=app_password_here
MAIL_FROM=example@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_SSL=True
MAIL_TLS=False

# S3 storage
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
